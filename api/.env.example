# Développement local : copier en .env (ignoré par Git), puis : set -a; source .env; set +a
DATABASE_URL=postgres://arrondi:arrondi-dev@127.0.0.1:5432/arrondi?sslmode=disable
PUBLIC_BASE_URL=http://localhost:5173
# En dev : Enable Banking refuse localhost, on lui donne l'URL de prod déclarée dans sa console.
# Au retour de la banque, remplacer https://arrondi.timotheebenchergui.fr par http://localhost:5173 dans la barre d'adresse.
EB_REDIRECT_URL=https://arrondi.timotheebenchergui.fr/api/v1/bank/callback
MASTER_KEY_FILE=./master_key.dev          # créer avec : openssl rand -base64 32 > master_key.dev
BOOTSTRAP_ADMIN_EMAIL=timothee.benchergui@gmail.com

# Remplace Cloudflare Access par une identité fixe. JAMAIS en production.
APP_ENV=dev
DEV_USER_EMAIL=timothee.benchergui@gmail.com

# Production uniquement (à la place de APP_ENV/DEV_USER_EMAIL) :
# CF_ACCESS_TEAM_DOMAIN=<equipe>.cloudflareaccess.com
# CF_ACCESS_AUD=<audience de l'application Access>
